---
import Layout from '../layouts/Layout.astro';
import en from '../content/en.json';
import es from '../content/es.json';

const icons: Record<string, string> = {
  search: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>`,
  code: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  zap: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
  chart: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
  layers: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`,
  users: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
};
---

<Layout>
<!-- ═══════════════════════════════ NAV ═══════════════════════════════ -->
<nav>
  <div class="nav-inner">
    <a href="#" class="nav-logo">Sergei Kolesnikov</a>

    <ul class="nav-links">
      <li><a href="#services"><span class="en">{en.nav_services}</span><span class="es">{es.nav_services}</span></a></li>
      <li><a href="#about"><span class="en">{en.nav_about}</span><span class="es">{es.nav_about}</span></a></li>
      <li><a href="#pricing"><span class="en">{en.nav_pricing}</span><span class="es">{es.nav_pricing}</span></a></li>
      <li><a href="#contact"><span class="en">{en.nav_contact}</span><span class="es">{es.nav_contact}</span></a></li>
    </ul>

    <div class="nav-right">
      <div class="lang-toggle" role="group" aria-label="Language">
        <button class="lang-btn active" data-lang="en">EN</button>
        <button class="lang-btn" data-lang="es">ES</button>
      </div>
      <a href="#contact" class="btn-nav">
        <span class="en">{en.nav_cta}</span><span class="es">{es.nav_cta}</span>
      </a>
    </div>
  </div>
</nav>

<main>
<!-- ═══════════════════════════════ HERO ══════════════════════════════ -->
<section class="hero" id="top">
  <div class="container hero-content">
    <div class="hero-label en">{en.hero_label}</div>
    <div class="hero-label es">{es.hero_label}</div>

    <h1 class="hero-title">
      <span class="en">{en.hero_title.split('\n')[0]}<br/>{en.hero_title.split('\n')[1]}</span>
      <span class="es">{es.hero_title.split('\n')[0]}<br/>{es.hero_title.split('\n')[1]}</span>
    </h1>

    <p class="hero-subtitle">
      <span class="en">{en.hero_subtitle}</span>
      <span class="es">{es.hero_subtitle}</span>
    </p>

    <div class="hero-ctas">
      <a href="#contact" class="btn-primary">
        <span class="en">{en.hero_cta_primary}</span><span class="es">{es.hero_cta_primary}</span>
      </a>
      <a href="#services" class="btn-secondary">
        <span class="en">{en.hero_cta_secondary}</span><span class="es">{es.hero_cta_secondary}</span>
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════ ABOUT ═════════════════════════════ -->
<section class="section section-alt" id="about">
  <div class="container">
    <div class="section-header fade-in">
      <div class="section-label">
        <span class="en">{en.about_title}</span>
        <span class="es">{es.about_title}</span>
      </div>
    </div>

    <div class="about-grid">
      <div class="about-text fade-in">
        <p class="about-intro">
          <span class="en">{en.about_intro}</span>
          <span class="es">{es.about_intro}</span>
        </p>
        <p class="about-body">
          <span class="en">{en.about_body}</span>
          <span class="es">{es.about_body}</span>
        </p>
        <p class="about-location">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span class="en">{en.about_location}</span>
          <span class="es">{es.about_location}</span>
        </p>
      </div>

      <ul class="about-highlights fade-in">
        {en.about_highlights.map((item, i) => (
          <li>
            <span class="en">{item}</span>
            <span class="es">{es.about_highlights[i]}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════ SERVICES ══════════════════════════ -->
<section class="section" id="services">
  <div class="container">
    <div class="section-header fade-in">
      <h2 class="section-title">
        <span class="en">{en.services_title}</span>
        <span class="es">{es.services_title}</span>
      </h2>
      <p class="section-subtitle">
        <span class="en">{en.services_subtitle}</span>
        <span class="es">{es.services_subtitle}</span>
      </p>
    </div>

    <div class="services-grid">
      {en.services.map((service, i) => (
        <div class="service-card fade-in">
          <div class="service-icon" set:html={icons[service.icon]} />
          <h3>
            <span class="en">{service.title}</span>
            <span class="es">{es.services[i].title}</span>
          </h3>
          <p>
            <span class="en">{service.description}</span>
            <span class="es">{es.services[i].description}</span>
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════ WHY ME ════════════════════════════ -->
<section class="section section-alt" id="why">
  <div class="container">
    <div class="section-header fade-in">
      <h2 class="section-title">
        <span class="en">{en.why_title}</span>
        <span class="es">{es.why_title}</span>
      </h2>
    </div>

    <div class="why-grid">
      {en.why_items.map((item, i) => (
        <div class="why-card fade-in">
          <h3>
            <span class="en">{item.title}</span>
            <span class="es">{es.why_items[i].title}</span>
          </h3>
          <p>
            <span class="en">{item.description}</span>
            <span class="es">{es.why_items[i].description}</span>
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════ PRICING ═══════════════════════════ -->
<section class="section" id="pricing">
  <div class="container">
    <div class="section-header fade-in">
      <h2 class="section-title">
        <span class="en">{en.pricing_title}</span>
        <span class="es">{es.pricing_title}</span>
      </h2>
      <p class="section-subtitle">
        <span class="en">{en.pricing_subtitle}</span>
        <span class="es">{es.pricing_subtitle}</span>
      </p>
    </div>

    <div class="pricing-grid">
      {en.pricing_items.map((item, i) => (
        <div class={`pricing-card fade-in${item.highlight ? ' highlight' : ''}`}>
          <h3>
            <span class="en">{item.title}</span>
            <span class="es">{es.pricing_items[i].title}</span>
          </h3>
          <div class="pricing-price">
            <span class="en">{item.price}</span>
            <span class="es">{es.pricing_items[i].price}</span>
          </div>
          <p>
            <span class="en">{item.description}</span>
            <span class="es">{es.pricing_items[i].description}</span>
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════ CONTACT ═══════════════════════════ -->
<section class="section section-alt contact-section" id="contact">
  <div class="container">
    <div class="section-header fade-in" style="text-align:center; margin-bottom:0;">
      <h2 class="section-title">
        <span class="en">{en.contact_title}</span>
        <span class="es">{es.contact_title}</span>
      </h2>
      <p class="section-subtitle" style="margin: 16px auto 0; max-width: 520px;">
        <span class="en">{en.contact_subtitle}</span>
        <span class="es">{es.contact_subtitle}</span>
      </p>
    </div>

    <div class="contact-cards fade-in">
      <a href={`mailto:${en.contact_email}`} class="contact-card">
        <div class="contact-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <span class="contact-card-label">
          <span class="en">{en.contact_email_label}</span>
          <span class="es">{es.contact_email_label}</span>
        </span>
        <span class="contact-card-value">{en.contact_email}</span>
        <span class="btn-contact">
          <span class="en">{en.contact_cta}</span>
          <span class="es">{es.contact_cta}</span>
        </span>
      </a>

      <a href="https://www.linkedin.com/in/kolesnikov-sergei" target="_blank" rel="noopener" class="contact-card">
        <div class="contact-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
        </div>
        <span class="contact-card-label">LinkedIn</span>
        <span class="contact-card-value">Sergei Kolesnikov</span>
        <span class="btn-contact">
          <span class="en">{en.contact_linkedin}</span>
          <span class="es">{es.contact_linkedin}</span>
        </span>
      </a>
    </div>
  </div>
</section>
</main>

<!-- ═══════════════════════════════ FOOTER ════════════════════════════ -->
<footer>
  <div class="footer-inner">
    <div>
      <div class="footer-name">Sergei Kolesnikov</div>
      <div class="footer-tagline">
        <span class="en">{en.footer_tagline}</span>
        <span class="es">{es.footer_tagline}</span>
      </div>
    </div>
    <div class="footer-location">
      <span class="en">{en.footer_location}</span>
      <span class="es">{es.footer_location}</span>
    </div>
    <div class="footer-rights">
      © {new Date().getFullYear()} Sergei Kolesnikov.
      <span class="en">{en.footer_rights}</span>
      <span class="es">{es.footer_rights}</span>
    </div>
  </div>
</footer>
</Layout>

<style>
/* ─── Reset & Base ─── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  background: #fff;
  color: #1d1d1f;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ─── Language toggle ─── */
.es { display: none; }
body.lang-es .en { display: none; }
body.lang-es .es { display: inline; }
body.lang-es .es.block { display: block; }

/* ─── Navigation ─── */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  background: rgba(255, 255, 255, 0.78);
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
}
.nav-inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 24px;
  height: 54px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}
.nav-logo {
  font-size: 1rem;
  font-weight: 600;
  color: #1d1d1f;
  text-decoration: none;
  flex-shrink: 0;
  letter-spacing: -0.01em;
}
.nav-links {
  display: flex;
  gap: 28px;
  list-style: none;
}
.nav-links a {
  font-size: 0.84rem;
  color: #1d1d1f;
  text-decoration: none;
  opacity: 0.75;
  transition: opacity 0.2s;
}
.nav-links a:hover { opacity: 1; }
.nav-right {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-shrink: 0;
}
.lang-toggle {
  display: flex;
  background: rgba(0,0,0,0.06);
  border-radius: 20px;
  padding: 2px;
  gap: 2px;
}
.lang-btn {
  border: none;
  background: transparent;
  padding: 4px 12px;
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  border-radius: 16px;
  color: #6e6e73;
  transition: all 0.2s;
  font-family: inherit;
  letter-spacing: 0.02em;
}
.lang-btn.active {
  background: #fff;
  color: #1d1d1f;
  box-shadow: 0 1px 4px rgba(0,0,0,0.14);
}
.btn-nav {
  background: #0071e3;
  color: #fff;
  border: none;
  border-radius: 980px;
  padding: 8px 18px;
  font-size: 0.84rem;
  font-weight: 500;
  cursor: pointer;
  text-decoration: none;
  transition: background 0.2s;
  font-family: inherit;
  white-space: nowrap;
}
.btn-nav:hover { background: #0077ed; }

/* ─── Layout helpers ─── */
.container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 24px;
}
.section { padding: 100px 0; }
.section-alt { background: #f5f5f7; }
.section-header { margin-bottom: 52px; }
.section-label {
  font-size: 0.8rem;
  font-weight: 700;
  color: #0071e3;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 10px;
}
.section-title {
  font-size: clamp(2rem, 4vw, 2.8rem);
  font-weight: 700;
  letter-spacing: -0.028em;
  line-height: 1.1;
  color: #1d1d1f;
  margin-bottom: 14px;
}
.section-subtitle {
  font-size: 1.05rem;
  color: #6e6e73;
  max-width: 580px;
  line-height: 1.6;
}

/* ─── Hero ─── */
.hero {
  padding: 148px 0 100px;
  text-align: center;
  background: #fff;
}
.hero-content { display: flex; flex-direction: column; align-items: center; }
.hero-label {
  display: inline-block;
  font-size: 0.8rem;
  font-weight: 700;
  color: #0071e3;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 22px;
  padding: 6px 16px;
  background: rgba(0, 113, 227, 0.08);
  border-radius: 20px;
}
.hero-title {
  font-size: clamp(3rem, 6.5vw, 5.2rem);
  font-weight: 800;
  letter-spacing: -0.045em;
  line-height: 1.05;
  color: #1d1d1f;
  margin-bottom: 26px;
  max-width: 820px;
}
.hero-subtitle {
  font-size: clamp(1rem, 1.8vw, 1.2rem);
  color: #6e6e73;
  max-width: 560px;
  margin: 0 auto 44px;
  line-height: 1.65;
}
.hero-ctas {
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
}
.btn-primary {
  background: #0071e3;
  color: #fff;
  border: none;
  border-radius: 980px;
  padding: 15px 30px;
  font-size: 1rem;
  font-weight: 500;
  cursor: pointer;
  text-decoration: none;
  transition: background 0.2s;
  display: inline-block;
  font-family: inherit;
}
.btn-primary:hover { background: #0077ed; }
.btn-secondary {
  background: transparent;
  color: #0071e3;
  border: 1.5px solid rgba(0, 113, 227, 0.4);
  border-radius: 980px;
  padding: 15px 30px;
  font-size: 1rem;
  font-weight: 500;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.2s;
  display: inline-block;
  font-family: inherit;
}
.btn-secondary:hover {
  border-color: #0071e3;
  background: rgba(0, 113, 227, 0.05);
}

/* ─── About ─── */
.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 72px;
  align-items: start;
}
.about-intro {
  font-size: 1.2rem;
  color: #1d1d1f;
  font-weight: 400;
  line-height: 1.55;
  margin-bottom: 18px;
}
.about-body {
  font-size: 0.97rem;
  color: #6e6e73;
  line-height: 1.72;
  margin-bottom: 22px;
}
.about-location {
  font-size: 0.88rem;
  color: #6e6e73;
  display: flex;
  align-items: center;
  gap: 6px;
}
.about-highlights {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.about-highlights li {
  padding: 18px 20px;
  background: #fff;
  border-radius: 16px;
  border: 1px solid #e8e8ed;
  font-size: 0.875rem;
  color: #1d1d1f;
  line-height: 1.55;
  transition: box-shadow 0.2s;
}
.about-highlights li:hover {
  box-shadow: 0 4px 20px rgba(0,0,0,0.06);
}

/* ─── Services ─── */
.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}
.service-card {
  background: #fff;
  border-radius: 22px;
  padding: 30px;
  border: 1px solid #e8e8ed;
  transition: box-shadow 0.3s, transform 0.3s;
}
.service-card:hover {
  box-shadow: 0 8px 40px rgba(0,0,0,0.1);
  transform: translateY(-2px);
}
.service-icon {
  width: 46px;
  height: 46px;
  background: rgba(0, 113, 227, 0.08);
  border-radius: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18px;
  color: #0071e3;
}
.service-card h3 {
  font-size: 1.02rem;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 10px;
  letter-spacing: -0.015em;
  line-height: 1.3;
}
.service-card p {
  font-size: 0.865rem;
  color: #6e6e73;
  line-height: 1.65;
}

/* ─── Why me ─── */
.why-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
}
.why-card {
  background: #fff;
  border-radius: 22px;
  padding: 34px;
  border: 1px solid #e8e8ed;
  transition: box-shadow 0.3s;
}
.why-card:hover {
  box-shadow: 0 6px 30px rgba(0,0,0,0.07);
}
.why-card h3 {
  font-size: 1.08rem;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 12px;
  letter-spacing: -0.015em;
}
.why-card p {
  font-size: 0.9rem;
  color: #6e6e73;
  line-height: 1.7;
}

/* ─── Pricing ─── */
.pricing-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16px;
}
.pricing-card {
  background: #fff;
  border-radius: 22px;
  padding: 24px 20px;
  border: 1px solid #e8e8ed;
  display: flex;
  flex-direction: column;
  gap: 10px;
  transition: box-shadow 0.3s, transform 0.3s;
}
.pricing-card:hover {
  box-shadow: 0 6px 28px rgba(0,0,0,0.09);
  transform: translateY(-2px);
}
.pricing-card.highlight {
  background: #0071e3;
  border-color: #0071e3;
}
.pricing-card.highlight h3 { color: rgba(255,255,255,0.85); }
.pricing-card.highlight .pricing-price { color: #fff; }
.pricing-card.highlight p { color: rgba(255,255,255,0.72); }
.pricing-card h3 {
  font-size: 0.9rem;
  font-weight: 600;
  color: #1d1d1f;
  letter-spacing: -0.01em;
  line-height: 1.3;
}
.pricing-price {
  font-size: 1.05rem;
  font-weight: 700;
  color: #0071e3;
  letter-spacing: -0.02em;
}
.pricing-card p {
  font-size: 0.8rem;
  color: #6e6e73;
  line-height: 1.55;
  flex: 1;
}

/* ─── Contact ─── */
.contact-section { text-align: center; }
.contact-cards {
  display: flex;
  justify-content: center;
  gap: 20px;
  margin-top: 48px;
  flex-wrap: wrap;
}
.contact-card {
  background: #fff;
  border-radius: 24px;
  padding: 36px 44px;
  display: flex;

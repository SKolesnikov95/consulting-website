---
import Layout from '../layouts/Layout.astro';
import en from '../content/en.json';
import es from '../content/es.json';

const icons: Record<string, string> = {
  search: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>`,
  code:   `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  zap:    `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
  chart:  `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
  layers: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`,
  users:  `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
};

const logos = [
  { name: 'Tinkoff',    src: '/assets/logo-tinkoff-mono.png', h: 44 },
  { name: 'Finom',      src: '/assets/logo-finom-mono.png',   h: 26 },
  { name: 'Nebius',     src: '/assets/logo-nebius-mono.png',  h: 22 },
  { name: 'Extruct AI', src: '/assets/logo-extruct-mono.png', h: 22 },
];
---

<Layout>

<!-- ═══════════════════════════════ NAV ═══════════════════════════════ -->
<nav>
  <div class="nav-inner">
    <a href="#" class="nav-logo">Sergei Kolesnikov</a>
    <ul class="nav-links">
      <li><a href="#about"><span class="en">{en.nav_about}</span><span class="es">{es.nav_about}</span></a></li>
      <li><a href="#services"><span class="en">{en.nav_services}</span><span class="es">{es.nav_services}</span></a></li>
      <li><a href="#contact"><span class="en">{en.nav_contact}</span><span class="es">{es.nav_contact}</span></a></li>
    </ul>
    <div class="nav-right">
      <div class="lang-toggle" role="group" aria-label="Language">
        <button class="lang-btn active" data-lang="en">EN</button>
        <button class="lang-btn" data-lang="es">ES</button>
      </div>
      <a href="#contact" class="btn-nav">
        <span class="en">{en.nav_cta}</span><span class="es">{es.nav_cta}</span>
      </a>
    </div>
  </div>
</nav>

<main>

<!-- ═══════════════════════════════ HERO ══════════════════════════════ -->
<section class="hero" id="top">
  <div class="container hero-layout">

    <!-- Left column -->
    <div class="hero-text">
      <div class="hero-eyebrow">
        <span class="en">{en.hero_label}</span><span class="es">{es.hero_label}</span>
      </div>
      <h1 class="hero-title">
        <span class="en">{en.hero_title}</span>
        <span class="es">{es.hero_title}</span>
      </h1>
      <p class="hero-sub">
        <span class="en">{en.hero_subtitle}</span>
        <span class="es">{es.hero_subtitle}</span>
      </p>
      <div class="hero-ctas">
        <a href="#contact" class="btn-primary">
          <span class="en">{en.hero_cta_primary}</span><span class="es">{es.hero_cta_primary}</span>
        </a>
        <a href="#services" class="btn-secondary">
          <span class="en">{en.hero_cta_secondary}</span><span class="es">{es.hero_cta_secondary}</span>
        </a>
      </div>

      <!-- 3 cred cards below CTAs -->
      <div class="hero-creds">
        {en.about_creds.map((cred, i) => (
          <div class="hero-cred">
            <div class="cred-key">
              <span class="en">{cred.k}</span><span class="es">{es.about_creds[i].k}</span>
            </div>
            <div class="cred-title">
              <span class="en">{cred.t}</span><span class="es">{es.about_creds[i].t}</span>
            </div>
            <p class="cred-desc">
              <span class="en">{cred.d}</span><span class="es">{es.about_creds[i].d}</span>
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Right column: photo -->
    <div class="hero-photo-col">
      <img src="/photo.jpg" alt="Sergei Kolesnikov" class="hero-photo" />
    </div>

  </div>
</section>

<!-- ═══════════════════════════ COMPANIES ════════════════════════════ -->
<section class="companies-section">
  <div class="container">
    <div class="section-label fade-in" style="margin-bottom:20px;">
      <span class="en">{en.companies_label}</span><span class="es">{es.companies_label}</span>
    </div>
    <div class="logos-grid fade-in">
      {logos.map(l => (
        <div class="logo-card">
          <img src={l.src} alt={l.name} style={`max-height:${l.h}px;`} />
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════ TESTIMONIAL ════════════════════════════ -->
<section class="testimonial-section">
  <div class="container">
    <div class="section-label fade-in" style="margin-bottom:24px;">
      <span class="en">{en.testimonials_label}</span><span class="es">{es.testimonials_label}</span>
    </div>
    <div class="testimonial-card fade-in">
      <div class="testimonial-quote-mark">"</div>
      <blockquote class="testimonial-text">
        <span class="en">{en.testimonial_quote}</span>
        <span class="es">{es.testimonial_quote}</span>
      </blockquote>
      <div class="testimonial-author">
        <img src="/ivo-avatar.png" alt="Ivo Dimitrov" class="testimonial-avatar" />
        <div class="testimonial-meta">
          <div class="testimonial-name">{en.testimonial_author}</div>
          <div class="testimonial-role">
            <span class="en">{en.testimonial_role}</span><span class="es">{es.testimonial_role}</span>
          </div>
        </div>
        <a href="https://www.linkedin.com/in/skolesnikov/details/recommendations/" target="_blank" rel="noopener" class="testimonial-li" aria-label="View on LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════ ABOUT ═════════════════════════════ -->
<section class="section section-alt" id="about">
  <div class="container">
    <div class="section-header fade-in">
      <h2 class="section-title">
        <span class="en">{en.about_title}</span>
        <span class="es">{es.about_title}</span>
      </h2>
    </div>

    <div class="about-body-grid fade-in">
      <p class="about-p">
        <span class="en">{en.about_intro}</span>
        <span class="es">{es.about_intro}</span>
      </p>
      <p class="about-p">
        <span class="en">{en.about_body}</span>
        <span class="es">{es.about_body}</span>
      </p>
    </div>

    <div class="diffs-grid">
      {en.about_diffs.map((diff, i) => (
        <div class="diff-card fade-in">
          <h3 class="diff-title">
            <span class="en">{diff.t}</span>
            <span class="es">{es.about_diffs[i].t}</span>
          </h3>
          <p class="diff-desc">
            <span class="en">{diff.d}</span>
            <span class="es">{es.about_diffs[i].d}</span>
          </p>
        </div>
      ))}
    </div>

    <div class="about-location fade-in">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <span class="en">{en.about_location}</span>
      <span class="es">{es.about_location}</span>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════ SERVICES ══════════════════════════ -->
<section class="section" id="services">
  <div class="container">
    <div class="section-header fade-in">
      <h2 class="section-title">
        <span class="en">{en.services_title}</span>
        <span class="es">{es.services_title}</span>
      </h2>
      <p class="section-subtitle">
        <span class="en">{en.services_subtitle}</span>
        <span class="es">{es.services_subtitle}</span>
      </p>
    </div>

    <div class="services-grid">
      {en.services.map((service, i) => (
        <div class="service-card fade-in">
          <div class="service-icon" set:html={icons[service.icon]} />
          <h3 class="service-title">
            <span class="en">{service.title}</span>
            <span class="es">{es.services[i].title}</span>
          </h3>
          <p class="service-desc">
            <span class="en">{service.description}</span>
            <span class="es">{es.services[i].description}</span>
          </p>
          <div class="service-result">
            <span class="service-result-label">Deliverable: </span>
            <span class="en">{service.result}</span>
            <span class="es">{es.services[i].result}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════ CONTACT ═══════════════════════════ -->
<section class="section section-alt contact-section" id="contact">
  <div class="container">
    <div class="section-header fade-in" style="text-align:center; margin-bottom:0;">
      <h2 class="section-title">
        <span class="en">{en.contact_title}</span>
        <span class="es">{es.contact_title}</span>
      </h2>
      <p class="section-subtitle" style="margin:14px auto 0; max-width:520px;">
        <span class="en">{en.contact_subtitle}</span>
        <span class="es">{es.contact_subtitle}</span>
      </p>
    </div>

    <div class="contact-cards fade-in">
      <a href={`mailto:${en.contact_email}`} class="contact-card">
        <div class="contact-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <span class="contact-card-label"><span class="en">{en.contact_email_label}</span><span class="es">{es.contact_email_label}</span></span>
        <span class="contact-card-value">{en.contact_email}</span>
        <span class="btn-contact"><span class="en">{en.contact_cta}</span><span class="es">{es.contact_cta}</span></span>
      </a>

      <a href="https://www.linkedin.com/in/skolesnikov/" target="_blank" rel="noopener" class="contact-card">
        <div class="contact-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
        </div>
        <span class="contact-card-label">LinkedIn</span>
        <span class="contact-card-value">Sergei Kolesnikov</span>
        <span class="btn-contact"><span class="en">{en.contact_linkedin}</span><span class="es">{es.contact_linkedin}</span></span>
      </a>

      <a href="https://t.me/serkolesnikov" target="_blank" rel="noopener" class="contact-card">
        <div class="contact-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </div>
        <span class="contact-card-label">Telegram</span>
        <span class="contact-card-value">{en.contact_telegram}</span>
        <span class="btn-contact">{en.contact_telegram}</span>
      </a>
    </div>

    <div class="contact-or fade-in">
      <span class="contact-or-line"></span>
      <span class="contact-or-text"><span class="en">or leave a request</span><span class="es">o deja una solicitud</span></span>
      <span class="contact-or-line"></span>
    </div>

    <div class="form-wrapper fade-in">
      <h3 class="form-title">
        <span class="en">{en.form_title}</span><span class="es">{es.form_title}</span>
      </h3>
      <p class="form-subtitle-text">
        <span class="en">{en.form_subtitle}</span><span class="es">{es.form_subtitle}</span>
      </p>
      <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="contact-form" id="contact-form">
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden-field"><label>Don't fill this: <input name="bot-field" /></label></p>
        <div class="form-group">
          <input type="text" name="name" required id="form-name-field" placeholder=" " />
          <label for="form-name-field"><span class="en">{en.form_name}</span><span class="es">{es.form_name}</span></label>
        </div>
        <div class="form-group">
          <input type="email" name="email" required id="form-email-field" placeholder=" " />
          <label for="form-email-field"><span class="en">{en.form_email}</span><span class="es">{es.form_email}</span></label>
        </div>
        <div class="form-group">
          <textarea name="message" rows="4" id="form-message-field" placeholder=" "></textarea>
          <label for="form-message-field"><span class="en">{en.form_message}</span><span class="es">{es.form_message}</span></label>
        </div>
        <button type="submit" class="btn-primary btn-submit">
          <span class="en">{en.form_submit}</span><span class="es">{es.form_submit}</span>
        </button>
      </form>
      <div class="form-success" id="form-success">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <p><span class="en">{en.form_success}</span><span class="es">{es.form_success}</span></p>
      </div>
    </div>
  </div>
</section>

</main>

<!-- ═══════════════════════════════ FOOTER ════════════════════════════ -->
<footer>
  <div class="footer-inner">
    <div>
      <div class="footer-name">Sergei Kolesnikov</div>
      <div class="footer-tagline"><span class="en">{en.footer_tagline}</span><span class="es">{es.footer_tagline}</span></div>
    </div>
    <div class="footer-location"><span class="en">{en.footer_location}</span><span class="es">{es.footer_location}</span></div>
    <div class="footer-rights">© {new Date().getFullYear()} Sergei Kolesnikov. <span class="en">{en.footer_rights}</span><span class="es">{es.footer_rights}</span></div>
  </div>
</footer>

</Layout>

<style>
/* ─── Reset ─── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  background: #fff;
  color: #1d1d1f;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* ─── Language ─── */
.es { display: none !important; }
body.lang-es .en { display: none !important; }
body.lang-es .es { display: inline !important; }

/* ─── Nav ─── */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  background: rgba(255,255,255,0.82);
  border-bottom: 1px solid rgba(0,0,0,0.08);
}
.nav-inner {
  max-width: 1100px; margin: 0 auto; padding: 0 24px;
  height: 54px; display: flex; align-items: center;
  justify-content: space-between; gap: 20px;
}
.nav-logo { font-size: 0.95rem; font-weight: 600; color: #1d1d1f; text-decoration: none; flex-shrink: 0; letter-spacing: -0.01em; }
.nav-links { display: flex; gap: 26px; list-style: none; }
.nav-links a { font-size: 0.84rem; color: #1d1d1f; text-decoration: none; opacity: 0.7; transition: opacity 0.2s; }
.nav-links a:hover { opacity: 1; }
.nav-right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
.lang-toggle { display: flex; background: rgba(0,0,0,0.06); border-radius: 20px; padding: 2px; gap: 2px; }
.lang-btn { border: none; background: transparent; padding: 4px 11px; font-size: 0.76rem; font-weight: 600; cursor: pointer; border-radius: 16px; color: #6e6e73; transition: all 0.2s; font-family: inherit; letter-spacing: 0.02em; }
.lang-btn.active { background: #fff; color: #1d1d1f; box-shadow: 0 1px 4px rgba(0,0,0,0.14); }
.btn-nav { background: #0071e3; color: #fff; border-radius: 980px; padding: 7px 16px; font-size: 0.84rem; font-weight: 500; cursor: pointer; text-decoration: none; transition: background 0.2s; white-space: nowrap; }
.btn-nav:hover { background: #0077ed; }

/* ─── Layout ─── */
.container { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
.section { padding: 88px 0; }
.section-alt { background: #f5f5f7; }
.section-header { margin-bottom: 48px; }
.section-label { font-size: 0.75rem; font-weight: 700; color: #0071e3; letter-spacing: 0.09em; text-transform: uppercase; }
.section-title { font-size: clamp(1.8rem, 3.5vw, 2.6rem); font-weight: 700; letter-spacing: -0.025em; line-height: 1.15; color: #1d1d1f; margin-bottom: 12px; }
.section-subtitle { font-size: 1rem; color: #6e6e73; line-height: 1.65; }

/* ─── Hero ─── */
.hero { padding: 118px 0 80px; background: #fff; }
.hero-layout {
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: 60px;
  align-items: start;
}
.hero-text { display: flex; flex-direction: column; }
.hero-eyebrow { font-size: 0.75rem; font-weight: 700; color: #0071e3; letter-spacing: 0.09em; text-transform: uppercase; margin-bottom: 18px; }
.hero-title { font-size: clamp(2.2rem, 4.5vw, 3.8rem); font-weight: 800; letter-spacing: -0.038em; line-height: 1.08; color: #1d1d1f; margin-bottom: 18px; }
.hero-sub { font-size: clamp(0.95rem, 1.4vw, 1.08rem); color: #6e6e73; line-height: 1.65; margin-bottom: 28px; max-width: 520px; }
.hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 36px; }

/* Cred cards inside hero */
.hero-creds {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border: 1px solid #e8e8ed;
  border-radius: 18px;
  overflow: hidden;
}
.hero-cred {
  background: #fff;
  padding: 22px 20px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  border-right: 1px solid #e8e8ed;
}
.hero-cred:last-child { border-right: none; }

/* Photo */
.hero-photo-col { position: sticky; top: 78px; }
.hero-photo { display: block; width: 100%; aspect-ratio: 3/4; object-fit: cover; object-position: center 5%; border-radius: 24px; box-shadow: 0 20px 52px rgba(0,0,0,0.13); }

/* Shared cred styles */
.cred-key { font-size: 0.68rem; font-weight: 700; color: #0071e3; letter-spacing: 0.07em; text-transform: uppercase; }
.cred-title { font-size: 0.88rem; font-weight: 600; color: #1d1d1f; line-height: 1.25; letter-spacing: -0.01em; }
.cred-desc { font-size: 0.78rem; color: #6e6e73; line-height: 1.58; }

/* ─── Buttons ─── */
.btn-primary { background: #0071e3; color: #fff; border: none; border-radius: 980px; padding: 13px 26px; font-size: 0.95rem; font-weight: 500; cursor: pointer; text-decoration: none; transition: background 0.2s; display: inline-block; font-family: inherit; }
.btn-primary:hover { background: #0077ed; }
.btn-secondary { background: transparent; color: #0071e3; border: 1.5px solid rgba(0,113,227,0.4); border-radius: 980px; padding: 13px 26px; font-size: 0.95rem; font-weight: 500; cursor: pointer; text-decoration: none; transition: all 0.2s; display: inline-block; font-family: inherit; }
.btn-secondary:hover { border-color: #0071e3; background: rgba(0,113,227,0.05); }

/* ─── Companies ─── */
.companies-section { padding: 48px 0; border-top: 1px solid #f0f0f0; border-bottom: 1px solid #f0f0f0; }
.logos-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }

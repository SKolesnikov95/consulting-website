---
import Layout from '../layouts/Layout.astro';
import en from '../content/en.json';
import es from '../content/es.json';

const icons: Record<string, string> = {
  search: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>`,
  code: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  zap: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
  chart: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
  layers: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`,
  users: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
};
---

<Layout>
<!-- ═══════════════════════════════ NAV ═══════════════════════════════ -->
<nav>
  <div class="nav-inner">
    <a href="#" class="nav-logo">Sergei Kolesnikov</a>

    <ul class="nav-links">
      <li><a href="#services"><span class="en">{en.nav_services}</span><span class="es">{es.nav_services}</span></a></li>
      <li><a href="#about"><span class="en">{en.nav_about}</span><span class="es">{es.nav_about}</span></a></li>
      <li><a href="#contact"><span class="en">{en.nav_contact}</span><span class="es">{es.nav_contact}</span></a></li>
    </ul>

    <div class="nav-right">
      <div class="lang-toggle" role="group" aria-label="Language">
        <button class="lang-btn active" data-lang="en">EN</button>
        <button class="lang-btn" data-lang="es">ES</button>
      </div>
      <a href="#contact" class="btn-nav">
        <span class="en">{en.nav_cta}</span><span class="es">{es.nav_cta}</span>
      </a>
    </div>
  </div>
</nav>

<main>
<!-- ═══════════════════════════════ HERO ══════════════════════════════ -->
<section class="hero" id="top">
  <div class="container hero-content">
    <div class="hero-label">
      <span class="en">{en.hero_label}</span><span class="es">{es.hero_label}</span>
    </div>

    <h1 class="hero-title">
      <span class="en">{en.hero_title.split('\n')[0]}<br/>{en.hero_title.split('\n')[1]}</span>
      <span class="es">{es.hero_title.split('\n')[0]}<br/>{es.hero_title.split('\n')[1]}</span>
    </h1>

    <p class="hero-subtitle">
      <span class="en">{en.hero_subtitle}</span>
      <span class="es">{es.hero_subtitle}</span>
    </p>

    <div class="hero-ctas">
      <a href="#contact" class="btn-primary">
        <span class="en">{en.hero_cta_primary}</span><span class="es">{es.hero_cta_primary}</span>
      </a>
      <a href="#services" class="btn-secondary">
        <span class="en">{en.hero_cta_secondary}</span><span class="es">{es.hero_cta_secondary}</span>
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════ ABOUT ═════════════════════════════ -->
<section class="section section-alt" id="about">
  <div class="container">
    <div class="about-layout">

      <!-- Left: photo -->
      <div class="about-photo-col fade-in">
        <div class="about-photo-wrap">
          <img src="/photo.jpg" alt="Sergei Kolesnikov" class="about-photo" />
        </div>
      </div>

      <!-- Right: text + career cards + location -->
      <div class="about-right-col" style="padding-top: 4px;">
        <div class="section-label fade-in">
          <span class="en">{en.about_title}</span>
          <span class="es">{es.about_title}</span>
        </div>

        <p class="about-intro fade-in">
          <span class="en">{en.about_intro}</span>
          <span class="es">{es.about_intro}</span>
        </p>
        <p class="about-body fade-in">
          <span class="en">{en.about_body}</span>
          <span class="es">{es.about_body}</span>
        </p>

        <div class="career-grid">
          {en.about_highlights.map((item, i) => {
            const parts = item.split(' — ');
            const esParts = es.about_highlights[i].split(' — ');
            return (
              <div class="career-card fade-in">
                <span class="career-num">0{i + 1}</span>
                <div class="career-role">
                  <span class="en">{parts[0]}</span>
                  <span class="es">{esParts[0]}</span>
                </div>
                <p class="career-desc">
                  <span class="en">{parts[1]}</span>
                  <span class="es">{esParts[1]}</span>
                </p>
              </div>
            );
          })}
        </div>

        <div class="about-location fade-in">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span class="en">{en.about_location}</span>
          <span class="es">{es.about_location}</span>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ═══════════════════════════════ SERVICES ══════════════════════════ -->
<section class="section" id="services">
  <div class="container">
    <div class="section-header fade-in">
      <h2 class="section-title">
        <span class="en">{en.services_title}</span>
        <span class="es">{es.services_title}</span>
      </h2>
      <p class="section-subtitle">
        <span class="en">{en.services_subtitle}</span>
        <span class="es">{es.services_subtitle}</span>
      </p>
    </div>

    <div class="services-grid">
      {en.services.map((service, i) => (
        <div class="service-card fade-in">
          <div class="service-icon" set:html={icons[service.icon]} />
          <h3>
            <span class="en">{service.title}</span>
            <span class="es">{es.services[i].title}</span>
          </h3>
          <p>
            <span class="en">{service.description}</span>
            <span class="es">{es.services[i].description}</span>
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════ WHY ME ════════════════════════════ -->
<section class="section section-alt" id="why">
  <div class="container">
    <div class="section-header fade-in">
      <h2 class="section-title">
        <span class="en">{en.why_title}</span>
        <span class="es">{es.why_title}</span>
      </h2>
    </div>

    <div class="why-grid">
      {en.why_items.map((item, i) => (
        <div class="why-card fade-in">
          <h3>
            <span class="en">{item.title}</span>
            <span class="es">{es.why_items[i].title}</span>
          </h3>
          <p>
            <span class="en">{item.description}</span>
            <span class="es">{es.why_items[i].description}</span>
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════ TESTIMONIAL ════════════════════════════ -->
<section class="section testimonial-section">
  <div class="container">
    <div class="testimonial-card fade-in">
      <div class="testimonial-quote-mark">"</div>
      <blockquote class="testimonial-text">
        Had a great time working with Sergey at Finom! He was a Head of AI who basically took our AI initiatives from zero to one, launching several AI agents even when we had pretty limited resources. He's super into numbers and data, and it shows in everything he does. Definitely recommend him for any data-driven challenge!
      </blockquote>
      <div class="testimonial-author">
        <img src="/ivo-avatar.png" alt="Ivo Dimitrov" class="testimonial-avatar" />
        <div class="testimonial-meta">
          <div class="testimonial-name">Ivo Dimitrov</div>
          <div class="testimonial-role">Co-founder &amp; Chief AI Officer at Finom</div>
        </div>
        <a href="https://www.linkedin.com/in/skolesnikov/details/recommendations/" target="_blank" rel="noopener" class="testimonial-li" aria-label="View on LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════ CONTACT ═══════════════════════════ -->
<section class="section contact-section" id="contact">
  <div class="container">
    <div class="section-header fade-in" style="text-align:center; margin-bottom:0;">
      <h2 class="section-title">
        <span class="en">{en.contact_title}</span>
        <span class="es">{es.contact_title}</span>
      </h2>
      <p class="section-subtitle" style="margin: 16px auto 0; max-width: 520px;">
        <span class="en">{en.contact_subtitle}</span>
        <span class="es">{es.contact_subtitle}</span>
      </p>
    </div>

    <div class="contact-cards fade-in">
      <a href={`mailto:${en.contact_email}`} class="contact-card">
        <div class="contact-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <span class="contact-card-label">
          <span class="en">{en.contact_email_label}</span>
          <span class="es">{es.contact_email_label}</span>
        </span>
        <span class="contact-card-value">{en.contact_email}</span>
        <span class="btn-contact">
          <span class="en">{en.contact_cta}</span>
          <span class="es">{es.contact_cta}</span>
        </span>
      </a>

      <a href="https://www.linkedin.com/in/skolesnikov/" target="_blank" rel="noopener" class="contact-card">
        <div class="contact-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
        </div>
        <span class="contact-card-label">LinkedIn</span>
        <span class="contact-card-value">Sergei Kolesnikov</span>
        <span class="btn-contact">
          <span class="en">{en.contact_linkedin}</span>
          <span class="es">{es.contact_linkedin}</span>
        </span>
      </a>

      <a href="https://t.me/serkolesnikov" target="_blank" rel="noopener" class="contact-card">
        <div class="contact-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </div>
        <span class="contact-card-label">
          <span class="en">{en.contact_telegram_label}</span>
          <span class="es">{es.contact_telegram_label}</span>
        </span>
        <span class="contact-card-value">{en.contact_telegram}</span>
        <span class="btn-contact">
          <span class="en">{en.contact_telegram}</span>
          <span class="es">{es.contact_telegram}</span>
        </span>
      </a>
    </div>

    <div class="contact-or fade-in">
      <span class="contact-or-line"></span>
      <span class="contact-or-text">
        <span class="en">or leave a request</span>
        <span class="es">o deja una solicitud</span>
      </span>
      <span class="contact-or-line"></span>
    </div>

    <div class="form-wrapper fade-in">
      <h3 class="form-title">
        <span class="en">{en.form_title}</span><span class="es">{es.form_title}</span>
      </h3>
      <p class="form-subtitle-text">
        <span class="en">{en.form_subtitle}</span><span class="es">{es.form_subtitle}</span>
      </p>

      <form
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="contact-form"
        id="contact-form"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden-field"><label>Don't fill this: <input name="bot-field" /></label></p>

        <div class="form-group">
          <input
            type="text"
            name="name"
            required
            id="form-name-field"
            placeholder=" "
          />
          <label for="form-name-field">
            <span class="en">{en.form_name}</span><span class="es">{es.form_name}</span>
          </label>
        </div>

        <div class="form-group">
          <input
            type="email"
            name="email"
            required
            id="form-email-field"
            placeholder=" "
          />
          <label for="form-email-field">
            <span class="en">{en.form_email}</span><span class="es">{es.form_email}</span>
          </label>
        </div>

        <div class="form-group">
          <textarea
            name="message"
            rows="4"
            id="form-message-field"
            placeholder=" "
          ></textarea>
          <label for="form-message-field">
            <span class="en">{en.form_message}</span><span class="es">{es.form_message}</span>
          </label>
        </div>

        <button type="submit" class="btn-primary btn-submit">
          <span class="en">{en.form_submit}</span><span class="es">{es.form_submit}</span>
        </button>
      </form>

      <div class="form-success" id="form-success">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <p><span class="en">{en.form_success}</span><span class="es">{es.form_success}</span></p>
      </div>
    </div>
  </div>
</section>
</main>

<!-- ═══════════════════════════════ FOOTER ════════════════════════════ -->
<footer>
  <div class="footer-inner">
    <div>
      <div class="footer-name">Sergei Kolesnikov</div>
      <div class="footer-tagline">
        <span class="en">{en.footer_tagline}</span>
        <span class="es">{es.footer_tagline}</span>
      </div>
    </div>
    <div class="footer-location">
      <span class="en">{en.footer_location}</span>
      <span class="es">{es.footer_location}</span>
    </div>
    <div class="footer-rights">
      © {new Date().getFullYear()} Sergei Kolesnikov.
      <span class="en">{en.footer_rights}</span>
      <span class="es">{es.footer_rights}</span>
    </div>
  </div>
</footer>
</Layout>

<style>
/* ─── Reset & Base ─── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  background: #fff;
  color: #1d1d1f;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ─── Language toggle ─── */
.es { display: none !important; }
body.lang-es .en { display: none !important; }
body.lang-es .es { display: inline !important; }
body.lang-es .es.block { display: block !important; }

/* ─── Navigation ─── */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  background: rgba(255, 255, 255, 0.78);
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
}
.nav-inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 24px;
  height: 54px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}
.nav-logo {
  font-size: 1rem;
  font-weight: 600;
  color: #1d1d1f;
  text-decoration: none;
  flex-shrink: 0;
  letter-spacing: -0.01em;
}
.nav-links {
  display: flex;
  gap: 28px;
  list-style: none;
}
.nav-links a {
  font-size: 0.84rem;
  color: #1d1d1f;
  text-decoration: none;
  opacity: 0.75;
  transition: opacity 0.2s;
}
.nav-links a:hover { opacity: 1; }
.nav-right {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-shrink: 0;
}
.lang-toggle {
  display: flex;
  background: rgba(0,0,0,0.06);
  border-radius: 20px;
  padding: 2px;
  gap: 2px;
}
.lang-btn {
  border: none;
  background: transparent;
  padding: 4px 12px;
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  border-radius: 16px;
  color: #6e6e73;
  transition: all 0.2s;
  font-family: inherit;
  letter-spacing: 0.02em;
}
.lang-btn.active {
  background: #fff;
  color: #1d1d1f;
  box-shadow: 0 1px 4px rgba(0,0,0,0.14);
}
.btn-nav {
  background: #0071e3;
  color: #fff;
  border: none;
  border-radius: 980px;
  padding: 8px 18px;
  font-size: 0.84rem;
  font-weight: 500;
  cursor: pointer;
  text-decoration: none;
  transition: background 0.2s;
  font-family: inherit;
  white-space: nowrap;
}
.btn-nav:hover { background: #0077ed; }

/* ─── Layout helpers ─── */
.container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 24px;
}
.section { padding: 100px 0; }
.section-alt { background: #f5f5f7; }
.section-header { margin-bottom: 52px; }
.section-label {
  font-size: 0.8rem;
  font-weight: 700;
  color: #0071e3;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 10px;
}
.section-title {
  font-size: clamp(2rem, 4vw, 2.8rem);
  font-weight: 700;
  letter-spacing: -0.028em;
  line-height: 1.1;
  color: #1d1d1f;
  margin-bottom: 14px;
}
.section-subtitle {
  font-size: 1.05rem;
  color: #6e6e73;
  max-width: 580px;
  line-height: 1.6;
}

/* ─── Hero ─── */
.hero {
  padding: 148px 0 100px;
  text-align: center;
  background: #fff;
}
.hero-content { display: flex; flex-direction: column; align-items: center; }
.hero-label {
  display: inline-block;
  font-size: 0.8rem;
  font-weight: 700;
  color: #0071e3;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 22px;
  padding: 6px 16px;
  background: rgba(0, 113, 227, 0.08);
  border-radius: 20px;
}
.hero-title {
  font-size: clamp(3rem, 6.5vw, 5.2rem);
  font-weight: 800;
  letter-spacing: -0.045em;
  line-height: 1.05;
  color: #1d1d1f;
  margin-bottom: 26px;
  max-width: 820px;
}
.hero-subtitle {
  font-size: clamp(1rem, 1.8vw, 1.2rem);
  color: #6e6e73;
  max-width: 560px;
  margin: 0 auto 44px;
  line-height: 1.65;
}
.hero-ctas {
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
}
.btn-primary {
  background: #0071e3;
  color: #fff;
  border: none;
  border-radius: 980px;
  padding: 15px 30px;
  font-size: 1rem;
  font-weight: 500;
  cursor: pointer;
  text-decoration: none;
  transition: background 0.2s;
  display: inline-block;
  font-family: inherit;
}
.btn-primary:hover { background: #0077ed; }
.btn-secondary {
  background: transparent;
  color: #0071e3;
  border: 1.5px solid rgba(0, 113, 227, 0.4);
  border-radius: 980px;
  padding: 15px 30px;
  font-size: 1rem;
  font-weight: 500;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.2s;
  display: inline-block;
  font-family: inherit;
}
.btn-secondary:hover {
  border-color: #0071e3;
  background: rgba(0, 113, 227, 0.05);
}

/* ─── About ─── */
.about-layout {
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 56px;
  align-items: center;
}
